# Copy to .env and fill in. .env is gitignored.

# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token.
# The same token works for the provisioner (export it as DISCORD_TOKEN there too).
DISCORD_TOKEN=

# Where the SQLite file lives. Back this up. It is the asset.
STEWARD_DB=data/steward.sqlite3

# Event history retention in days. Member funnel timestamps are kept regardless,
# because four dates per member is not a history. 400 gives you a full year
# plus room to compute year-over-year without a gap.
RETENTION_DAYS=400

# Channel name that later stages post digests into.
REPORT_CHANNEL=steward-reports

# Where the blueprint is. Found automatically, so this is only needed if you
# keep it somewhere unusual. Steward reads it for the level thresholds and for
# which roles are marked `ephemeral: true`, which are the "How did you find
# us?" answers it records and then takes straight back off.
#STEWARD_BLUEPRINT=../blueprint/default.yaml

# The channel the moderation log goes to.
MOD_CHANNEL=mod-log

# Launch day, as YYYY-MM-DD. Every beat in the content calendar is written as an
# offset from this, so with nothing here the calendar loads and then sits still.
# Setting it here rather than in the calendar file is deliberate: the file is the
# part you redeploy to the next project, and the date is not.
LAUNCH_DATE=2027-03-01

# Where the content calendar is. Found automatically next to the blueprint.
#STEWARD_CALENDAR=../blueprint/content-calendar.yaml

# The role /playtest-join hands out. Playtest announcements mention this role and
# nothing else: Discord's Developer Policy prohibits unsolicited direct messages,
# so an opt-in role is the only compliant way to reach people, and it is also the
# only one that can be revoked by the person receiving it.
PLAYTEST_ROLE=Ping Me For Playtests

# The forum channel /playtest-report files bugs into.
BUG_FORUM=bug-reports
